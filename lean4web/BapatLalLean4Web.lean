    (U W : Matrix (Fin n) (Fin 2) ℂ) (i j k l : Fin n)
    (hij : i ≠ j) (hkl : k ≠ l) :
    (∑ σ : Equiv.Perm (Fin n), if σ i = k ∧ σ j = l then
      remainingProduct (U * W.conjTranspose) σ i j else 0) =
