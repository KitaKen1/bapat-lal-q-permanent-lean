def pairMatchingFinEquiv {n : ℕ} {i j k l : Fin n} (hij : i ≠ j) (hkl : k ≠ l) :
    {σ : Equiv.Perm (Fin n) // σ i = k ∧ σ j = l} ≃ Equiv.Perm (Fin (n - 2)) :=
  (pairMatchingEquiv hij hkl).trans
